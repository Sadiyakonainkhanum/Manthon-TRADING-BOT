# ==============================================================================
# MANTHAN 2026 Autonomous Trading Systems Challenge - Environment Configuration
# ==============================================================================
# All connection coordinates must be obtained from the Registration Desk and 
# the Participant Portal (http://<SERVER_IP>:3003) on the venue Wi-Fi network.

# Competition Server Coordinates
SERVER_IP=
ORDER_GATEWAY_PORT=3002
KAFKA_PORT=9094
PARTICIPANT_PORTAL_PORT=3003

# Authentication & Consumer Group
# Persistent token from Step 1 of Participant Guide UI
BOT_ACCESS_TOKEN=
# Exact Team username - forms consumer group: group-MN2645
TEAM_USERNAME=MN2645

# Operating & Safety Modes:
# Set DEMO_MODE to 'false' when connected to the venue Wi-Fi competition server.
# Set SUBMIT_LIVE_ORDERS to 'true' ONLY when ready to dispatch real orders to /api/v1/orders.
DEMO_MODE=true
SUBMIT_LIVE_ORDERS=false

# Strategy & Risk Parameters
DECISION_LATENCY_MAX_MS=3000
MIN_CASH_BUFFER_PCT=0.20
MAX_STOCK_CONCENTRATION_PCT=0.25
STOP_LOSS_PCT=0.035
TAKE_PROFIT_PCT=0.05
MAX_ORDERS_PER_MINUTE=110

# Local Telemetry & Dashboard Server
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

